# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Editor cruft
*.swp
*.swo
.idea/
.vscode/

# Node, in case a template gains a helper later
node_modules/
npm-debug.log*

# The real denylist is machine-local: your list of secrets is itself a secret.
.githooks/denylist.local

# Layer-2 tool artifacts (derived, never committed)
.memory-index.db
memory-tools.json
memory-graph/

# Mirrored copies of other people's repos. Derived and disposable, and someone
# else's content besides: never commit it into this tree.
.memory-mirrors/

# Python bytecode (my py_compile check left these once)
__pycache__/
*.pyc

# Agent worktrees. This repo is public and every commit runs a leak gate over
# what is staged, so a whole second checkout sitting untracked in the tree is one
# `git add .` away from being published. Ignoring it keeps `git status` honest too:
# an untracked directory here reads as real work when it is only scratch space.
.claude-worktrees/
